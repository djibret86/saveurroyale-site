# ===== Saveur Royale — à coller TOUT EN HAUT du fichier .htaccess existant =====
RewriteEngine On

# 1. Une seule adresse officielle : https://www.saveurroyale.com
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.saveurroyale.com/$1 [L,R=301]

# 2. Anciennes pages de l'ancien site (boutique WordPress) -> page d'accueil
RewriteRule ^index\.php/.+$ / [L,R=301]
RewriteRule ^(product|produit|store|shop|boutique|panier|cart|checkout|commande|my-account|mon-compte|product-category|categorie-produit)(/.*)?$ / [L,R=301]

# 3. Toute autre adresse inconnue affiche le site plutôt qu'une page d'erreur
ErrorDocument 404 /index.html
# ===== fin du bloc Saveur Royale =====

# ===== Sécurité (en-têtes) — chaque bloc est ignoré si le module manque, pas d'erreur 500 =====
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  # CSP volontairement souple : interdit l'affichage du site dans une autre page et les plugins,
  # sans bloquer les scripts de la page, les photos, Google Fonts ni Facebook.
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ===== Vitesse : compression et cache des fichiers fixes (pas de index.html ni stock.json) =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
